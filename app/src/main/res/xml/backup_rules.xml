<?xml version="1.0" encoding="utf-8"?>
<!--
  Room's database stores SAF (Storage Access Framework) tree/document URIs,
  which are meaningless once restored onto a different device or a fresh
  install with different grants. Same for the DataStore preferences file,
  which only holds device-local UI state. Both are excluded from backup.
-->
<full-backup-content>
    <exclude domain="database" path="auralis.db" />
    <exclude domain="database" path="auralis.db-wal" />
    <exclude domain="database" path="auralis.db-shm" />
    <exclude domain="file" path="datastore/settings.preferences_pb" />
    <exclude domain="file" path="artwork/" />
</full-backup-content>
